{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=DBLocal/orders.db"
  },
  "JwtSettings": {
    "SecretKey": "super-secret-key-change-in-production-min-32-chars!!",
    "Issuer": "OrderManagement.API",
